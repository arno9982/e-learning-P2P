<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.HTMLEditor?>

<AnchorPane xmlns="http://javafx.com/javafx/21.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.CourseEditorController"
            prefWidth="900.0" prefHeight="650.0">

    <VBox spacing="12"
          AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"
          AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10"
          styleClass="screen">

        <!-- barre titre + action -->
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="toolbar">
            <Label text="Éditeur de cours" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="saveCourseButton" text="Enregistrer le cours"
                    onAction="#handleSaveCourse" styleClass="primary"/>
            <padding><Insets bottom="5.0"/></padding>
        </HBox>

        <HBox spacing="20" VBox.vgrow="ALWAYS">

            <!-- Colonne gauche : structure + formulaire -->
            <VBox spacing="10" HBox.hgrow="NEVER" prefWidth="320">
                <Label text="Structure du cours" style="-fx-font-weight: bold;"/>
                <TreeView fx:id="courseStructureTree" prefWidth="300" VBox.vgrow="ALWAYS" styleClass="card"/>

                <HBox spacing="10">
                    <Button text="Ajouter" onAction="#handleAddNode" prefWidth="90"/>
                    <Button fx:id="editButton" text="Éditer" onAction="#handleEditNode" prefWidth="90" disable="true"/>
                    <Button text="Supprimer" onAction="#handleRemoveNode" prefWidth="90"/>
                </HBox>

                <TitledPane fx:id="addFormPane" text="Ajouter un élément" expanded="true"
                            visible="false" managed="false">
                    <content>
                        <VBox spacing="8">
                            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                            <Label text="Titre"/>
                            <TextField fx:id="addTitleField" promptText="Titre de l’élément"/>

                            <Label text="Type"/>
                            <ComboBox fx:id="addTypeCombo"/>

                            <Label fx:id="addContentTypeLabel" text="Type de contenu" visible="false" managed="false"/>
                            <ComboBox fx:id="addContentTypeCombo" visible="false" managed="false"/>

                            <Label fx:id="addFormErrorLabel" style="-fx-text-fill: #c0392b;"/>

                            <HBox spacing="10">
                                <Button text="Ajouter l’élément" onAction="#handleAddNodeFromForm" styleClass="primary"/>
                                <Button text="Annuler" onAction="#handleCancelAddForm"/>
                            </HBox>
                        </VBox>
                    </content>
                </TitledPane>
            </VBox>

            <!-- Colonne droite : éditeurs + IA -->
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label fx:id="contentTitleLabel" text="Sélectionnez un élément..."
                       style="-fx-font-weight: bold" />
                <Label fx:id="contentTypeLabel" text=""
                       style="-fx-font-size: 12px; -fx-font-style: italic;" />

                <StackPane VBox.vgrow="ALWAYS" styleClass="card">
                    <HTMLEditor fx:id="htmlEditor" visible="false" managed="false"/>
                    <TextField fx:id="linkTextField" promptText="Coller l’URL ici"
                               visible="false" managed="false" />
                    <VBox fx:id="resourceBox" spacing="10" visible="false" managed="false">
                        <Label fx:id="resourceLabel" />
                        <HBox spacing="10">
                            <Button fx:id="importResourceButton" text="Importer une ressource" onAction="#handleImportResource" />
                            <Button fx:id="removeResourceButton" text="Supprimer la ressource" onAction="#handleRemoveResource" />
                        </HBox>
                    </VBox>
                </StackPane>

                <TitledPane fx:id="aiPane" text="Assistant IA (pour Notion Texte)"
                            expanded="false" disable="true">
                    <content>
                        <VBox spacing="8">
                            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                            <Label text="Décrivez ce que doit contenir la notion (objectifs, exemples, niveau…)."/>
                            <TextArea fx:id="aiPromptArea"
                                      promptText="Ex : Explique le concept de POO avec un exemple Java et un mini quiz."
                                      prefRowCount="4"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Longueur cible (mots)"/>
                                <Spinner fx:id="aiWordsSpinner" prefWidth="120"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="aiGenerateButton" text="Générer dans l’éditeur"
                                        onAction="#handleGenerateWithAI" styleClass="primary"/>
                            </HBox>
                        </VBox>
                    </content>
                </TitledPane>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>
