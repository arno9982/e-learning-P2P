<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.web.WebView?>

<BorderPane fx:controller="org.example.controller.CourseConsultationController"
            xmlns="http://javafx.com/javafx/21.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            styleClass="screen">

    <left>
        <TreeView fx:id="courseTreeView" minWidth="260" styleClass="card"/>
    </left>

    <center>
        <VBox alignment="TOP_CENTER" spacing="12.0">
            <Label fx:id="notionTitleLabel"
                   text="Sélectionnez une notion"
                   style="-fx-font-size: 22; -fx-font-weight: bold;"/>

            <HBox alignment="CENTER" spacing="10.0" styleClass="toolbar">
                <Button fx:id="prevButton" onAction="#handlePrev" text="Précédent"/>
                <Button fx:id="nextButton" onAction="#handleNext" text="Suivant" />
            </HBox>

            <StackPane fx:id="contentPane" VBox.vgrow="ALWAYS" styleClass="card">
                <WebView fx:id="contentWebView" minHeight="520"/>
                <MediaView fx:id="mediaView"/>
            </StackPane>

            <HBox fx:id="mediaControls" alignment="CENTER" spacing="10.0"
                  managed="false" visible="false" styleClass="toolbar">
                <Button fx:id="playButton" text="▶️"/>
                <Button fx:id="pauseButton" text="⏸️"/>
                <Slider fx:id="progressBar" min="0" max="100" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
